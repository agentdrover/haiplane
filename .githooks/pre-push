#!/usr/bin/env sh
set -eu

remote_name="${1:-}"
zero="0000000000000000000000000000000000000000"

while read -r local_ref local_oid remote_ref remote_oid; do
  # Branch deletion (git push origin --delete <branch> / git push origin :ref):
  # git sets local_ref to the literal "(delete)" and local_oid to all-zeros.
  # A deletion publishes no code, so skip the branch-name and dirty-tree checks —
  # but still refuse to delete the protected branches.
  is_delete=0
  case "$local_oid" in
    "$zero" | "") is_delete=1 ;;
  esac
  case "$local_ref" in
    "(delete)" | "delete") is_delete=1 ;;
  esac
  if [ "$is_delete" = "1" ]; then
    case "$remote_ref" in
      refs/heads/main | refs/heads/develop)
        echo "Blocked delete of protected branch '${remote_ref#refs/heads/}' on ${remote_name}." >&2
        echo "Protected branches (main, develop) must not be deleted." >&2
        exit 1
        ;;
    esac
    continue
  fi

  case "$local_ref" in
    refs/heads/main)
      if [ "${ALLOW_MAIN_PUSH:-}" != "1" ]; then
        echo "Blocked push to main. Use a PR branch, or set ALLOW_MAIN_PUSH=1 for an explicit owner-approved emergency push." >&2
        exit 1
      fi
      ;;
    refs/heads/develop)
      ;;
    refs/heads/task-*/*|refs/heads/fix/*|refs/heads/chore/*|refs/heads/docs/*|refs/heads/ci/*)
      ;;
    *)
      echo "Blocked push from branch '${local_ref#refs/heads/}' to ${remote_name}." >&2
      echo "Use develop, task-<hub-task-id>/<short-slug>, fix/<short-slug>, chore/<short-slug>, docs/<short-slug>, or ci/<short-slug>." >&2
      exit 1
      ;;
  esac

  if [ -n "$(git status --porcelain)" ] && [ "${ALLOW_DIRTY_PUSH:-}" != "1" ]; then
    echo "Blocked push with a dirty working tree. Commit/stash unrelated changes, or set ALLOW_DIRTY_PUSH=1 intentionally." >&2
    exit 1
  fi
done
