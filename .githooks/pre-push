#!/usr/bin/env sh
set -eu

remote_name="${1:-}"
zero="0000000000000000000000000000000000000000"

# #475: which branches this clone protects is a property of the PROJECT, not
# of this file. The hub writes the haiplane.* keys when it arms the hook
# (hub/git_policy), so a calc-kids workspace protects master and a spike-bo
# one protects main. The literals below are the fallback for a clone nobody
# configured — the hub's own, which is where these names came from.
base_branch="$(git config --get haiplane.baseBranch 2>/dev/null || true)"
[ -n "$base_branch" ] || base_branch="develop"
release_branch="$(git config --get haiplane.releaseBranch 2>/dev/null || true)"
[ -n "$release_branch" ] || release_branch="main"

# #2000: the fast check before a push, ONLY when this clone agreed to it by a
# config key (`make hooks` sets it). Presence of a Makefile or of a target is not
# consent: the hub pushes task branches from clones on its own host, where the
# code of a branch must not run, and the hub never writes this key.
# --local: a global or system config must not switch this on for a clone that did
# not agree (a server-side clone of the hub reads the same global config).
pre_push_check_command="$(git config --local --get haiplane.prePushCheck 2>/dev/null || true)"

pre_push_check() {
  check_ref="$1"
  check_oid="$2"
  [ -n "$pre_push_check_command" ] || return 0
  case "$check_ref" in
    "refs/heads/$base_branch"|"refs/heads/$release_branch") return 0 ;;
  esac
  case "$check_ref" in
    refs/heads/task-*/*|refs/heads/fix/*|refs/heads/chore/*|refs/heads/docs/*|refs/heads/ci/*) ;;
    *) return 0 ;;
  esac
  if [ "${HAIPLANE_SKIP_PREPUSH:-}" = "1" ]; then
    echo "WARNING: pre-push check skipped (HAIPLANE_SKIP_PREPUSH=1): $pre_push_check_command" >&2
    return 0
  fi
  # A bare repository has no working copy to check; the branch policy still ran.
  [ "$(git rev-parse --is-bare-repository 2>/dev/null || echo true)" = "false" ] || return 0
  # The check runs on the working copy. It counts for the commit being pushed
  # only when that commit IS the checked-out one.
  head_oid="$(git rev-parse HEAD 2>/dev/null || true)"
  if [ "$check_oid" != "$head_oid" ]; then
    echo "WARNING: pre-push check NOT run for ${check_ref#refs/heads/}: the pushed commit is not the checked-out HEAD" >&2
    return 0
  fi
  # The default command is `make check-fast`, which needs uv. A cloud image or a
  # minimal PATH without them cannot run it: say so and let the push through
  # (nothing is remembered). Any other command is the clone's own business, and
  # its failure - including "command not found" (rc 127) - blocks.
  case "$pre_push_check_command" in
    *make*)
      if ! command -v make >/dev/null 2>&1 || ! command -v uv >/dev/null 2>&1; then
        echo "WARNING: pre-push check NOT run: make or uv is not available here" >&2
        return 0
      fi
      ;;
  esac
  check_tree="$(git rev-parse "$check_oid^{tree}")"
  cache_file="$(git rev-parse --git-path haiplane/prepush-ok 2>/dev/null || true)"
  # One line whatever the command holds (a multi-line command would otherwise
  # become several grep patterns): a hash of the tree, the commit it is compared
  # with (a rebase onto another base changes the selection) and the command.
  base_oid="$(git rev-parse --verify -q "origin/$base_branch" 2>/dev/null || true)"
  merge_base="$(git merge-base "$check_oid" "origin/$base_branch" 2>/dev/null || true)"
  cache_key="$(printf '%s\n%s\n%s\n%s\n' "$check_tree" "$base_oid" "$merge_base" "$pre_push_check_command" | git hash-object --stdin)"
  check_clean=0
  if [ -z "$(git status --porcelain)" ]; then check_clean=1; fi
  if [ "$check_clean" = "1" ] && [ -n "$cache_file" ] && [ -f "$cache_file" ] &&
     grep -qxF -- "$cache_key" "$cache_file" 2>/dev/null; then
    echo "pre-push check: already passed for this tree" >&2
    return 0
  fi
  echo "pre-push check: $pre_push_check_command" >&2
  # The command must not read the ref lines git feeds to this hook on stdin.
  if sh -c "$pre_push_check_command" </dev/null >&2; then check_rc=0; else check_rc=$?; fi
  if [ "$check_rc" -ne 0 ]; then
    echo "Blocked push of ${check_ref#refs/heads/}: '$pre_push_check_command' failed (rc=$check_rc)." >&2
    [ "$check_rc" -ne 127 ] || echo "rc 127: the shell did not find a command of the check." >&2
    echo "Fix it; HAIPLANE_SKIP_PREPUSH=1 skips this check once (CI still runs everything)." >&2
    exit 1
  fi
  # Remember a pass only for a clean tree; a failure to remember is not an error.
  if [ "$check_clean" = "1" ] && [ -n "$cache_file" ]; then
    mkdir -p "$(dirname "$cache_file")" 2>/dev/null || return 0
    cache_tmp="$cache_file.$$"
    if { tail -n 19 "$cache_file" 2>/dev/null || true; printf '%s\n' "$cache_key"; } >"$cache_tmp" 2>/dev/null; then
      mv -f "$cache_tmp" "$cache_file" 2>/dev/null || rm -f "$cache_tmp" 2>/dev/null || true
    fi
  fi
  return 0
}

while read -r local_ref local_oid remote_ref remote_oid; do
  # Branch deletion (git push origin --delete <branch> / git push origin :ref):
  # git sets local_ref to the literal "(delete)" and local_oid to all-zeros.
  # A deletion publishes no code, so skip the branch-name and dirty-tree checks —
  # but still refuse to delete the protected branches.
  is_delete=0
  case "$local_oid" in
    "$zero" | "") is_delete=1 ;;
  esac
  case "$local_ref" in
    "(delete)" | "delete") is_delete=1 ;;
  esac
  if [ "$is_delete" = "1" ]; then
    if [ "$remote_ref" = "refs/heads/$release_branch" ] ||
       [ "$remote_ref" = "refs/heads/$base_branch" ]; then
      echo "Blocked delete of protected branch '${remote_ref#refs/heads/}' on ${remote_name}." >&2
      echo "Protected branches ($release_branch, $base_branch) must not be deleted." >&2
      exit 1
    fi
    continue
  fi

  if [ "$local_ref" = "refs/heads/$release_branch" ]; then
    if [ "${ALLOW_MAIN_PUSH:-}" != "1" ]; then
      echo "Blocked push to $release_branch. Use a PR branch, or set ALLOW_MAIN_PUSH=1 for an explicit owner-approved emergency push." >&2
      exit 1
    fi
  elif [ "$local_ref" = "refs/heads/$base_branch" ]; then
    :
  else
    case "$local_ref" in
      refs/heads/task-*/*|refs/heads/fix/*|refs/heads/chore/*|refs/heads/docs/*|refs/heads/ci/*)
        ;;
      # Dependabot opens its PRs from branches it names itself
      # ("dependabot/uv/anyio-4.14.2"); the prefix is not configurable in
      # .github/dependabot.yml, so the allowlist has to know it or a local
      # push onto a bot branch is refused.
      refs/heads/dependabot/*)
        ;;
      *)
        echo "Blocked push from branch '${local_ref#refs/heads/}' to ${remote_name}." >&2
        echo "Use $base_branch, task-<hub-task-id>/<short-slug>, fix/<short-slug>, chore/<short-slug>, docs/<short-slug>, ci/<short-slug>, or dependabot/<bot-branch>." >&2
        exit 1
        ;;
    esac
  fi

  if [ -n "$(git status --porcelain)" ] && [ "${ALLOW_DIRTY_PUSH:-}" != "1" ]; then
    echo "Blocked push with a dirty working tree. Commit/stash unrelated changes, or set ALLOW_DIRTY_PUSH=1 intentionally." >&2
    exit 1
  fi

  pre_push_check "$local_ref" "$local_oid"
done
