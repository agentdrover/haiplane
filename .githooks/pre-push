#!/usr/bin/env sh
set -eu

remote_name="${1:-}"
zero="0000000000000000000000000000000000000000"

# #475: which branches this clone protects is a property of the PROJECT, not
# of this file. The hub writes both key families when it arms the hook
# (hub/git_policy), so a calc-kids workspace protects master and a spike-bo
# one protects main. The literals below are the fallback for a clone nobody
# configured — the hub's own, which is where these names came from.
#
# haiplane.* first, then openclaw.* (Haiplane rename, Wave 3). NOT
# `new || old`: `git config --get` succeeds on a key that exists with an
# empty value, so the chain would stop there and hide the legacy answer.
# Read the new value, test it for emptiness, then read the legacy one.
base_branch="$(git config --get haiplane.baseBranch 2>/dev/null || true)"
if [ -z "$base_branch" ]; then
  base_branch="$(git config --get openclaw.baseBranch 2>/dev/null || true)"
fi
[ -n "$base_branch" ] || base_branch="develop"
release_branch="$(git config --get haiplane.releaseBranch 2>/dev/null || true)"
if [ -z "$release_branch" ]; then
  release_branch="$(git config --get openclaw.releaseBranch 2>/dev/null || true)"
fi
[ -n "$release_branch" ] || release_branch="main"

while read -r local_ref local_oid remote_ref remote_oid; do
  # Branch deletion (git push origin --delete <branch> / git push origin :ref):
  # git sets local_ref to the literal "(delete)" and local_oid to all-zeros.
  # A deletion publishes no code, so skip the branch-name and dirty-tree checks —
  # but still refuse to delete the protected branches.
  is_delete=0
  case "$local_oid" in
    "$zero" | "") is_delete=1 ;;
  esac
  case "$local_ref" in
    "(delete)" | "delete") is_delete=1 ;;
  esac
  if [ "$is_delete" = "1" ]; then
    if [ "$remote_ref" = "refs/heads/$release_branch" ] ||
       [ "$remote_ref" = "refs/heads/$base_branch" ]; then
      echo "Blocked delete of protected branch '${remote_ref#refs/heads/}' on ${remote_name}." >&2
      echo "Protected branches ($release_branch, $base_branch) must not be deleted." >&2
      exit 1
    fi
    continue
  fi

  if [ "$local_ref" = "refs/heads/$release_branch" ]; then
    if [ "${ALLOW_MAIN_PUSH:-}" != "1" ]; then
      echo "Blocked push to $release_branch. Use a PR branch, or set ALLOW_MAIN_PUSH=1 for an explicit owner-approved emergency push." >&2
      exit 1
    fi
  elif [ "$local_ref" = "refs/heads/$base_branch" ]; then
    :
  else
    case "$local_ref" in
      refs/heads/task-*/*|refs/heads/fix/*|refs/heads/chore/*|refs/heads/docs/*|refs/heads/ci/*)
        ;;
      *)
        echo "Blocked push from branch '${local_ref#refs/heads/}' to ${remote_name}." >&2
        echo "Use $base_branch, task-<hub-task-id>/<short-slug>, fix/<short-slug>, chore/<short-slug>, docs/<short-slug>, or ci/<short-slug>." >&2
        exit 1
        ;;
    esac
  fi

  if [ -n "$(git status --porcelain)" ] && [ "${ALLOW_DIRTY_PUSH:-}" != "1" ]; then
    echo "Blocked push with a dirty working tree. Commit/stash unrelated changes, or set ALLOW_DIRTY_PUSH=1 intentionally." >&2
    exit 1
  fi
done
