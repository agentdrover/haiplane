{
  "_comment": "HAIPLANE_HUB_URL / HAIPLANE_HUB_MCP_TOKEN are the canonical env names.",
  "mcpServers": {
    "haiplane-hub-local": {
      "command": "uv",
      "args": ["run", "haiplane-hub-mcp"],
      "env": {
        "HAIPLANE_HUB_URL": "http://127.0.0.1:8080"
      }
    },
    "haiplane-hub": {
      "type": "streamable-http",
      "url": "https://your-hub.example/mcp",
      "headers": {
        "Authorization": "Bearer ${env:HAIPLANE_HUB_MCP_TOKEN}",
        "Accept": "application/json, text/event-stream"
      }
    }
  }
}
