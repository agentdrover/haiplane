[Unit]
Description=Haiplane Hub (FastAPI dashboard + API)
After=network-online.target
Wants=network-online.target

[Service]
# Пример юнита. Пути соответствуют схеме из deploy/remote-deploy.sh; реальный
# юнит на сервере может дополнительно задавать Environment=/EnvironmentFile=
# со своими значениями — они имеют приоритет над дефолтами кода.
User=openclaw
WorkingDirectory=/opt/openclaw-hub/src
ExecStart=/opt/openclaw-hub/venv/bin/python -m uvicorn hub.app:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
Environment=HOME=/var/lib/openclaw-hub
EnvironmentFile=/etc/openclaw-hub/openclaw-hub.env
EnvironmentFile=-/etc/openclaw-hub/secrets.env
# OPENCLAW_HUB_REPO=<owner>/<repo> — репозиторий по умолчанию, если нужен;
# обычно репозитории задаются на уровне проектов в самом хабе.
StandardOutput=append:/var/lib/openclaw-hub/hub.log
StandardError=append:/var/lib/openclaw-hub/hub.log

[Install]
WantedBy=multi-user.target
