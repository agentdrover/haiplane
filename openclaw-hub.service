[Unit]
Description=OpenClaw Hub (FastAPI dashboard + API)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/denis/services/openclaw-hub
ExecStart=/home/denis/services/openclaw-hub/.venv/bin/python -m uvicorn hub.app:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
Environment=HOME=/home/denis
Environment=PATH=/home/denis/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=OPENCLAW_HUB_REPO=mrPDA/vkuswill_bot
Environment=OPENCLAW_WORKSPACE_REPO=/home/denis/.openclaw/workspace-vkuswill/repo
StandardOutput=append:/home/denis/.local/state/openclaw-hub/hub.log
StandardError=append:/home/denis/.local/state/openclaw-hub/hub.log

[Install]
WantedBy=default.target
