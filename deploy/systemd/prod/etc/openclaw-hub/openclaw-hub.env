HAIPLANE_HUB_HOST=127.0.0.1
HAIPLANE_HUB_PORT=8080
HAIPLANE_HUB_HOME=/var/lib/openclaw-hub
HAIPLANE_HUB_DB=/var/lib/openclaw-hub/hub.db
HAIPLANE_TRANSCRIPTS_DIR=/var/lib/openclaw-hub/transcripts
HAIPLANE_HUB_COOKIE_SECURE=1
HAIPLANE_HUB_TOKENS=<скрыто>
HAIPLANE_WORKSPACE_REPO=/var/lib/openclaw-hub/workspaces/_default
HAIPLANE_HUB_URL=https://agenthai.ru
HAIPLANE_HUB_REPO=agentdrover/haiplane
HAIPLANE_HUB_ALLOWED_HOSTS=agenthai.ru,www.agenthai.ru,hub.agenthai.ru,haiplane.com,www.haiplane.com,localhost,127.0.0.1
