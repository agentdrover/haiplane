# /etc/haiplane-review-runner.env — конфиг службы-исполнителя (chmod 640,
# владелец root, группа haiplane-review). Единственный источник команды: задание
# хаба её не несёт и переопределить её не может (#1571).
#
# Тот же каталог, что у хаба в HAIPLANE_LOCAL_REVIEW_SPOOL_DIR.
HAIPLANE_REVIEW_RUNNER_SPOOL_DIR=<каталог данных хаба>/review-spool
# Каталог прогонов: setgid 2770, группа haiplane-review (как в шаге 2 рецепта).
HAIPLANE_REVIEW_RUNNER_SCRATCH_DIR=/var/lib/haiplane-review/scratch
# Форма строго `sudo -n -u <не root> /абсолютный/путь [аргументы]`; остальное
# служба не запускает. После врапера — те же аргументы CLI, что раньше шли в
# HAIPLANE_LOCAL_REVIEW_CMD (промт уходит в stdin, не в argv).
HAIPLANE_REVIEW_RUNNER_ARGV=/usr/bin/sudo -n -u haiplane-reviewer /usr/local/bin/haiplane-review-run <argv агентского CLI>
# Потолок срока прогона, секунды: задание просит срок, служба не даст больше.
HAIPLANE_REVIEW_RUNNER_MAX_TIMEOUT_SEC=1800
# --timeout врапера (файл timeout у врапера, секунды). Служба отвергает задание,
# чей срок короче: иначе хаб объявит снятие раньше, чем контейнер умрёт. Последний
# рубеж на форме sudo — именно этот --timeout, а не SIGKILL службы (он до
# потомка sudo не доходит). Не больше потолка выше. 0 — не проверять.
HAIPLANE_REVIEW_RUNNER_WRAPPER_TIMEOUT_SEC=1800
# Снимок исходников (#1599): потолки распаковки. Распаковщик — файл
# snapshot_unpack.py рядом со службой (root-овый каталог); здесь он не настраивается.
# MAX_BYTES не меньше HAIPLANE_LOCAL_REVIEW_SNAPSHOT_MAX_BYTES хаба.
HAIPLANE_REVIEW_RUNNER_SNAPSHOT_MAX_BYTES=67108864
HAIPLANE_REVIEW_RUNNER_SNAPSHOT_MAX_ENTRIES=50000
HAIPLANE_REVIEW_RUNNER_SNAPSHOT_MAX_DEPTH=32
