# Скопируйте в .env.local в корне репозитория (файл в .gitignore).
HAIPLANE_HUB_HOST=127.0.0.1
HAIPLANE_HUB_PORT=8080
HAIPLANE_HUB_DB=/absolute/path/to/haiplane/.local/state/hub.db
# Три идентичности: человек + агент-исполнитель + агент-ревьюер (#432).
# Universal Review Gate сравнивает принципалов: вердикт от идентичности,
# которая делала pair-start/claim, отклоняется (self_review_forbidden),
# поэтому у ревьюера должно быть СВОЁ имя и СВОЙ токен.
HAIPLANE_HUB_TOKENS=you:your-human-token:human,cursor:your-agent-token:agent,cursor-reviewer:your-reviewer-token:agent
HAIPLANE_HUB_REPO=org/haiplane
HAIPLANE_WORKSPACE_REPO=/absolute/path/to/haiplane
HAIPLANE_HUB_URL=http://127.0.0.1:8080
HAIPLANE_HUB_TOKEN=your-human-token
# Токен для reviewer-сессии: оркестратор экспортирует его как
# HAIPLANE_HUB_TOKEN в окружении ревью-агента (см. docs/agent-onboarding.md).
# Cursor Cloud-ревьюер аутентифицируется отдельным ключом, который читает код:
# CURSOR_REVIEWER_HUB_TOKEN=your-reviewer-token
# Локальный ревьюер (#1180) — второй способ добыть машинное ревью, работает на
# любом форже. Выключен, пока не заданы ВСЕ четыре переменные; порядок выката и
# решение об изоляции — deploy/LOCAL-REVIEW.md. Песочница обязательна: пустая
# HAIPLANE_LOCAL_REVIEW_SANDBOX означает «пути нет», а не «запускай как есть».
# Префикс HAIPLANE_ обязателен: config.env_get читает ТОЛЬКО с ним, а имя без
# префикса не ломает запуск, а молча выключает локальный путь (#1208).
# HAIPLANE_LOCAL_REVIEW_CMD=<argv агентского CLI, промт уходит ему в stdin>
# HAIPLANE_LOCAL_REVIEW_SANDBOX=/usr/bin/sudo -n -u haiplane-reviewer /usr/local/bin/haiplane-review-run
# (песочница принимает ЗАКРЫТЫЙ набор форм — sudo и systemd-run --scope, обе
#  оставляют CLI потомком хаба. Всё остальное, включая podman run прямо в этой
#  переменной, отвергается с названной причиной: формы и отказы перечислены в
#  deploy/LOCAL-REVIEW.md. Флаги podman зафиксированы внутри враппера, в
#  sudoers — ни одной подстановки.)
# HAIPLANE_LOCAL_REVIEW_SCRATCH_DIR=/var/lib/haiplane-review/scratch
# HAIPLANE_LOCAL_REVIEWER_HUB_TOKEN=ключ принципала local-reviewer, СВОЙ, не общий с облачным
# Необязательные, показаны с умолчаниями:
# HAIPLANE_LOCAL_REVIEW_TIMEOUT_SEC=1800
# HAIPLANE_LOCAL_REVIEW_TOKEN_CEILING=2000000
# HAIPLANE_LOCAL_REVIEW_DIFF_CHAR_CEILING=150000
# HAIPLANE_LOCAL_REVIEW_DIFF_CONTEXT_LINES=20
# HAIPLANE_LOCAL_REVIEW_DEEP_TOKEN_CEILING=10000000
# HAIPLANE_LOCAL_REVIEW_MODEL=qwen3.8-max
# Снимок исходников для ревьюера (#1599): выключен, пока не выполнен «Выкат
# снимка» (deploy/LOCAL-REVIEW.md): распаковщик → служба → обёртка → эта настройка.
# HAIPLANE_LOCAL_REVIEW_SNAPSHOT=0
# HAIPLANE_LOCAL_REVIEW_SNAPSHOT_MAX_BYTES=67108864
# Только при direct: root-овый snapshot_unpack.py (при runner его грузит служба):
# HAIPLANE_LOCAL_REVIEW_SNAPSHOT_UNPACKER=/usr/local/lib/haiplane-review-runner/snapshot_unpack.py
# Только при direct: путь снимка глазами ревьюера (пусто — <workdir>/src; контейнерная обёртка — /work/src):
# HAIPLANE_LOCAL_REVIEW_SNAPSHOT_PATH=
# Транспорт запуска (#1571). direct — хаб сам запускает песочницу; runner — хаб
# только кладёт задание в каталог очереди, запуск делает служба-исполнитель
# (deploy/review-runner/, рецепт в deploy/LOCAL-REVIEW.md). Нужен там, где юнит
# хаба идёт с ProtectSystem=strict и NoNewPrivileges=yes. При runner SANDBOX,
# CMD и SCRATCH_DIR — это конфиг службы, а не хаба.
# HAIPLANE_LOCAL_REVIEW_TRANSPORT=direct
# HAIPLANE_LOCAL_REVIEW_SPOOL_DIR=<каталог данных хаба>/review-spool
# Локальный советник стюарда на GLM (#1649, вариант Б): профиль advisor службы
# ревью, ответ только из сессии steward_advisor. ОДНА закреплённая модель; хаб
# сверяет её с heartbeat службы до выпуска кода доступа. Нужны транспорт runner,
# HAIPLANE_STEWARD_HUB_TOKEN и выкат из deploy/LOCAL-REVIEW.md («Советник стюарда
# на GLM»); токен ревьюера советнику не нужен.
# HAIPLANE_STEWARD_ADVISOR_LOCAL_MODEL=glm-5.1
# Порядок предпочтения кандидатов; локальная модель берётся в своём порядке.
# HAIPLANE_STEWARD_ADVISOR_MODELS=glm-5.1,gpt-5.3-codex
