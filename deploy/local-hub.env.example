# Скопируйте в .env.local в корне репозитория (файл в .gitignore).
OPENCLAW_HUB_HOST=127.0.0.1
OPENCLAW_HUB_PORT=8080
OPENCLAW_HUB_DB=/absolute/path/to/openclaw-hub-standalone/.local/state/hub.db
# Три идентичности: человек + агент-исполнитель + агент-ревьюер (#432).
# Universal Review Gate сравнивает принципалов: вердикт от идентичности,
# которая делала pair-start/claim, отклоняется (self_review_forbidden),
# поэтому у ревьюера должно быть СВОЁ имя и СВОЙ токен.
OPENCLAW_HUB_TOKENS=you:your-human-token:human,cursor:your-agent-token:agent,cursor-reviewer:your-reviewer-token:agent
OPENCLAW_HUB_REPO=org/openclaw-hub-standalone
OPENCLAW_WORKSPACE_REPO=/absolute/path/to/openclaw-hub-standalone
OPENCLAW_HUB_URL=http://127.0.0.1:8080
OPENCLAW_HUB_TOKEN=your-human-token
# Токен для reviewer-сессии: оркестратор экспортирует его как
# OPENCLAW_HUB_TOKEN в окружении ревью-агента (см. docs/agent-onboarding.md).
# OPENCLAW_HUB_REVIEWER_TOKEN=your-reviewer-token
