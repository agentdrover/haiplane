# Скопируйте в .env.local в корне репозитория (файл в .gitignore).
OPENCLAW_HUB_HOST=127.0.0.1
OPENCLAW_HUB_PORT=8080
OPENCLAW_HUB_DB=/absolute/path/to/openclaw-hub-standalone/.local/state/hub.db
OPENCLAW_HUB_TOKENS=you:your-human-token:human,agent-name:your-agent-token:agent
OPENCLAW_HUB_REPO=org/openclaw-hub-standalone
OPENCLAW_WORKSPACE_REPO=/absolute/path/to/openclaw-hub-standalone
OPENCLAW_HUB_URL=http://127.0.0.1:8080
OPENCLAW_HUB_TOKEN=your-human-token
