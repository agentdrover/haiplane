# Скопируйте в .env.local в корне репозитория (файл в .gitignore).
HAIPLANE_HUB_HOST=127.0.0.1
HAIPLANE_HUB_PORT=8080
HAIPLANE_HUB_DB=/absolute/path/to/haiplane/.local/state/hub.db
# Три идентичности: человек + агент-исполнитель + агент-ревьюер (#432).
# Universal Review Gate сравнивает принципалов: вердикт от идентичности,
# которая делала pair-start/claim, отклоняется (self_review_forbidden),
# поэтому у ревьюера должно быть СВОЁ имя и СВОЙ токен.
HAIPLANE_HUB_TOKENS=you:your-human-token:human,cursor:your-agent-token:agent,cursor-reviewer:your-reviewer-token:agent
HAIPLANE_HUB_REPO=org/haiplane
HAIPLANE_WORKSPACE_REPO=/absolute/path/to/haiplane
HAIPLANE_HUB_URL=http://127.0.0.1:8080
HAIPLANE_HUB_TOKEN=your-human-token
# Токен для reviewer-сессии: оркестратор экспортирует его как
# HAIPLANE_HUB_TOKEN в окружении ревью-агента (см. docs/agent-onboarding.md).
# Cursor Cloud-ревьюер аутентифицируется отдельным ключом, который читает код:
# CURSOR_REVIEWER_HUB_TOKEN=your-reviewer-token
# Локальный ревьюер (#1180) — второй способ добыть машинное ревью, работает на
# любом форже. Выключен, пока не заданы ВСЕ четыре переменные; порядок выката и
# решение об изоляции — deploy/LOCAL-REVIEW.md. Песочница обязательна: пустая
# HAIPLANE_LOCAL_REVIEW_SANDBOX означает «пути нет», а не «запускай как есть».
# Префикс HAIPLANE_ обязателен: config.env_get читает ТОЛЬКО с ним, а имя без
# префикса не ломает запуск, а молча выключает локальный путь (#1208).
# HAIPLANE_LOCAL_REVIEW_CMD=<argv агентского CLI, промт уходит ему в stdin>
# HAIPLANE_LOCAL_REVIEW_SANDBOX=/usr/bin/sudo -n -u haiplane-reviewer /usr/local/bin/haiplane-review-run
# (обёртка обязана ЛИБО оставлять CLI потомком хаба, ЛИБО иметь свой срок жизни:
#  systemd-run без --scope и podman run без --timeout хаб отвергает, называя флаг.
#  Флаги podman зафиксированы внутри враппера, в sudoers — ни одной подстановки.)
# HAIPLANE_LOCAL_REVIEW_SCRATCH_DIR=/var/lib/haiplane-review/scratch
# HAIPLANE_LOCAL_REVIEWER_HUB_TOKEN=ключ принципала local-reviewer, СВОЙ, не общий с облачным
# Необязательные, показаны с умолчаниями:
# HAIPLANE_LOCAL_REVIEW_TIMEOUT_SEC=1800
# HAIPLANE_LOCAL_REVIEW_TOKEN_CEILING=2000000
